# Токен ИЗ НАСТРОЕК СООБЩЕСТВА (scope: messages)
VK_COMMUNITY_TOKEN=vk1.a.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ID сообщества (просто число, без минуса)
VK_GROUP_ID=234567890

# Куда слать:
#  — вариант A: ваш user_id (положительное число)
#  — вариант B: -234567890 (то же, что -VK_GROUP_ID)
VK_PEER_ID=123456789

VK_API_VERSION=5.199
